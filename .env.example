# ============================================================================
# VibeTrading configuration
# Copy this file to .env and fill in real values. Anything left blank falls
# back to a mock/paper implementation so the platform runs without live keys.
# ============================================================================

# --- Execution mode -----------------------------------------------------
# live  -> orders are placed against the real broker (requires DHAN_* below)
# paper -> orders are simulated in-memory, no real money moves
VIBETRADING_EXECUTION_MODE=paper

# Global kill switch. When true, the Risk Agent blocks new orders immediately.
VIBETRADING_KILL_SWITCH=false
# halt_new_orders -> blocks new entries, still allows stop-loss exits to fire
# halt_all        -> hard stop, blocks everything including protective exits
VIBETRADING_KILL_SWITCH_MODE=halt_new_orders
# Signs RiskApprovalTokens. MUST be a real random secret before going live
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
RISK_TOKEN_SECRET=dev-insecure-secret-change-me

# --- Dhan (DhanHQ) broker ------------------------------------------------
# Leave blank to run against the in-memory MockBrokerClient.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- LLM providers --------------------------------------------------------
# Set whichever provider(s) you want available; leave all blank to run every
# agent against the MockLLMAdapter (deterministic canned responses, no cost).
LLM_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional per-agent-type overrides (provider/model), e.g. "anthropic/claude-sonnet-5"
LLM_MODEL_RESEARCH=
LLM_MODEL_STRATEGY=
LLM_MODEL_BACKTEST=

# --- News / social data sources -------------------------------------------
# Each source is off by default (mock data only) until you enable it and
# confirm you're allowed to use it under that provider's terms of service.
NEWS_API_KEY=
NEWS_SOURCE_ENABLED=false

CHAT_SOURCE_TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=

CHAT_SOURCE_REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

CHAT_SOURCE_TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

CHAT_SOURCE_STOCKTWITS_ENABLED=false
CHAT_SOURCE_VALUEPICKR_ENABLED=false

# --- Watchlist --------------------------------------------------------------
WATCHLIST=RELIANCE,TCS,INFY

# --- Database -----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./vibetrading.db

# --- Agent scheduling intervals (seconds) --------------------------------
AGENT_INTERVAL_RESEARCH_SEC=900
AGENT_INTERVAL_STRATEGY_SEC=300
AGENT_INTERVAL_STOP_LOSS_MONITOR_SEC=30

# --- Risk Agent limits ----------------------------------------------------
RISK_MAX_POSITION_SIZE_INR=50000
RISK_MAX_PCT_CAPITAL_PER_STOCK=0.10
RISK_MAX_CONCURRENT_POSITIONS=5
RISK_MAX_DAILY_LOSS_INR=10000
RISK_MANDATORY_STOP_LOSS_PCT=0.03
RISK_MIN_SIGNAL_CONFIDENCE=0.65
RISK_MAX_TOTAL_EXPOSURE_PCT=0.50

# --- App server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
