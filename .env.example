# ============================================================================
# VibeTrading configuration
#
# As of the Settings UI (see README "Configuration"), everything about HOW
# VibeTrading trades — execution mode, Dhan credentials, LLM provider/keys,
# risk limits, watchlist, news/chat data sources — is configured at runtime
# from the dashboard's /settings page and stored (secrets encrypted) in the
# database, NOT here. This file is only the handful of variables the app
# needs before it can even open that database.
#
# Copy this file to .env; the defaults below are enough to boot the app with
# zero configuration (SQLite, paper mode, mock broker/LLM) and reach /settings
# to configure everything else.
# ============================================================================

# --- Database -----------------------------------------------------------
# SQLite by default (single developer, zero setup). Production runs
# against Postgres -- see README "Multi-tenancy & the distributed
# orchestrator" and "Deployment". DATABASE_POOL_SIZE/MAX_OVERFLOW only
# apply to a postgresql:// URL (SQLite's engine construction ignores them).
DATABASE_URL=sqlite+aiosqlite:///./vibetrading.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- App server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# WORKER_ROLE selects this process's role in the Web/Worker split (see
# README "Deployment"): "all" (default -- every dev/test path and a
# single-service deployment) runs both the API and every tenant's
# scheduler in one process; "web" never touches a tenant's lease or
# scheduler (a horizontally-scaled dashboard/API replica); "worker" (see
# scripts/run_worker.py) has no HTTP server at all and owns the trading
# loop. Only meaningful when running more than one replica.
WORKER_ROLE=all

# --- Cross-worker realtime fan-out (optional) -------------------------------
# Redis pub/sub lets a WebSocket connected to one replica see an event a
# scheduler cycle on a different worker process just published. Unset (the
# default) means every dev/test path needs zero Redis dependency --
# real-time push just degrades to "no live push," never an error, since
# nothing durable (orders, risk state) depends on it.
REDIS_URL=

# --- Alerting (optional) ----------------------------------------------------
# A webhook (Slack incoming-webhook URL, or any endpoint accepting
# {"text": ...}) that receives an alert when a circuit breaker opens (see
# vibetrading/core/reliability.py, vibetrading/observability/alerts.py).
# Unset means alerts are still logged at WARNING, just not posted anywhere.
ALERT_WEBHOOK_URL=

# --- Secrets encryption key -------------------------------------------------
# Encrypts every secret value entered in the Settings UI (Dhan access token,
# LLM API keys, data-source credentials) before it's written to the
# database. MUST be a real random secret before storing anything you care
# about (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Rotating it orphans every previously-stored secret — they decrypt to
# garbage and must be re-entered from the Settings UI.
APP_SECRETS_KEY=dev-insecure-key-change-me

# --- Auth session signing key ------------------------------------------------
# Signs every login session's JWT (vibetrading/auth/backend.py). MUST be a
# real random secret before any account's session should be trusted --
# same insecure-dev-default convention as APP_SECRETS_KEY/RISK_TOKEN_SECRET.
# Rotating it invalidates every existing session (a forced logout for
# everyone, not data loss).
AUTH_SECRET_KEY=dev-insecure-auth-secret-change-me

# Only send the session cookie over HTTPS. Leave false for local http://
# development; set true in every real deployment (render.yaml does).
AUTH_COOKIE_SECURE=false

# --- Risk approval token secret ---------------------------------------------
# Platform-wide (NOT per-tenant, and not in the Settings UI -- see README
# "Multi-tenancy & the distributed orchestrator") secret proving a
# RiskApprovalToken was minted by this platform's RiskEngine, not a tenant
# secret. MUST be a real random secret before enabling live trading for
# ANY tenant -- see "Enabling live trading" below.
RISK_TOKEN_SECRET=dev-insecure-secret-change-me
