# ============================================================================
# VibeTrading configuration
#
# As of the Settings UI (see README "Configuration"), everything about HOW
# VibeTrading trades — execution mode, Dhan credentials, LLM provider/keys,
# risk limits, watchlist, news/chat data sources — is configured at runtime
# from the dashboard's /settings page and stored (secrets encrypted) in the
# database, NOT here. This file is only the handful of variables the app
# needs before it can even open that database.
#
# Copy this file to .env; the defaults below are enough to boot the app with
# zero configuration (SQLite, paper mode, mock broker/LLM) and reach /settings
# to configure everything else.
# ============================================================================

# --- Database -----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./vibetrading.db

# --- App server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Secrets encryption key -------------------------------------------------
# Encrypts every secret value entered in the Settings UI (Dhan access token,
# LLM API keys, data-source credentials) before it's written to the
# database. MUST be a real random secret before storing anything you care
# about (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Rotating it orphans every previously-stored secret — they decrypt to
# garbage and must be re-entered from the Settings UI.
APP_SECRETS_KEY=dev-insecure-key-change-me
